{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wishlez",
  "version": "0.1.0",
  "identifier": "com.gopikrishna19.Wishlez",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Wishlez",
        "width": 800,
        "height": 600,
        "minWidth": 320,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "wfolio"
        ],
        "name": "Wishlez Portfolio",
        "role": "Editor",
        "rank": "Owner",
        "exportedType": {
          "identifier": "com.gopikrishna19.Wishlez.portfolio",
          "conformsTo": [
            "public.data"
          ]
        }
      }
    ]
  }
}
